 <office:meta>
  <dc:title>Ліхтарна книга</dc:title>
  <meta:initial-creator>Олена Перо</meta:initial-creator>
  <dc:creator>Олена Перо</dc:creator>
  <dc:language>uk-UA</dc:language>
  <meta:creation-date>2019-05-01T09:00:00</meta:creation-date>
 </office:meta>
 <office:body>
  <office:text>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Розділ перший</text:h>
   <text:p text:style-name="Text_20_body">Гавань вела рахунки у книзі ліхтарів<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Кожен ліхтар мав номер.</text:p></text:note-body></text:note>.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Підсумок</text:h>
   <text:p text:style-name="Text_20_body">Книгу закрили ввечері.</text:p>
  </office:text>
 </office:body>
</office:document>
