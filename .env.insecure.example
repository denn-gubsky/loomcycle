# loomcycle CONFIG (non-secret) — copy to .env.insecure and edit.
#
# This file holds ONLY non-secret operational config: listen address,
# storage paths, host allowlists, feature flags, timeouts, and
# the trigger-credential allowlists (which list env-var NAMES, never
# values). Nothing here is a secret, so it is safe to read, diff, and —
# if you keep your deployment in its own repo — commit.
#
# Companion file: .env.local (secrets — provider keys, the sidecar
# bearer, the secret VALUES behind the names allowlisted below). See
# `.env.local.example` and docs/CONFIGURATION.md §9c. Both files are
# sourced at startup by loomcycle.sh / loomcycle-mcp.sh.

# ─── Ollama base URLs (no auth; the hosted key lives in .env.local) ───
#   `ollama` provider       = hosted ollama.com, Bearer auth via OLLAMA_API_KEY.
#   `ollama-local` provider = local-network Ollama, no auth, default
#                             http://localhost:11434. Driven by OLLAMA_BASE_URL.
# The other ollama-local settings (num_gpu, the stream timeouts) are set in
# your loomcycle.yaml as `providers.ollama-local.options`, which is also where
# the vllm-local / llamacpp-local providers are declared; see
# `loomcycle presets show local`. The context window can be set in either
# place (LOOMCYCLE_OLLAMA_LOCAL_NUM_CTX below, or options.num_ctx); set in
# both, the variable wins. A yaml `base_url` replaces OLLAMA_BASE_URL.
# Existing deploys with OLLAMA_BASE_URL=http://localhost:11434 keep working
# unchanged — they now feed `ollama-local`. To opt out of the local
# registration entirely, set OLLAMA_BASE_URL=disabled.
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CLOUD_BASE_URL=https://ollama.com   # optional override
#
# num_ctx pins the input window Ollama runs every request in. Set it: without
# an explicit num_ctx Ollama silently truncates the prompt at its 4096-token
# default. It also doubles as the context window the interactive terminal's
# gauge reports (used/max/%) — unset, the gauge can only show the absolute
# used size (the per-model window isn't knowable from the driver).
# LOOMCYCLE_OLLAMA_LOCAL_NUM_CTX=32768
#
# The hosted ollama.com window, the layers offloaded to the GPU (num_gpu) and
# the stream timeouts are provider options in the yaml:
#   providers:
#     ollama:       { options: { num_ctx: 32768 } }
#     ollama-local: { options: { num_gpu: 99 } }   # 99 = all layers, where
#                                                  # Ollama falls back to CPU

# ─── Amazon Bedrock with AWS credentials (the `bedrock` preset) ─────
# The region the `bedrock` preset's providers sign for and call
# (bedrock-runtime.<region>.amazonaws.com). Required when the preset is
# selected (LOOMCYCLE_PRESETS=base,bedrock). Credentials are NOT set here:
# they come from the standard AWS chain — the instance / task / pod role on
# AWS, or AWS_PROFILE / AWS_ACCESS_KEY_ID elsewhere (keys go in .env.local).
# LOOMCYCLE_BEDROCK_REGION=eu-central-1

# ─── Sidecar listen ───────────────────────────────────────────────────
# (The bearer token /v1 routes require is a secret — set LOOMCYCLE_AUTH_TOKEN
# in .env.local.)
LOOMCYCLE_LISTEN_ADDR=127.0.0.1:8787
# With no LOOMCYCLE_AUTH_TOKEN and no admin operator token the server runs in
# open mode — every route unauthenticated — and refuses to start on an address
# beyond loopback (0.0.0.0, :8787, a LAN IP, or a gRPC LOOMCYCLE_GRPC_ADDR like
# :8788) unless this is set. For a throwaway test harness only: anything
# reachable should set LOOMCYCLE_AUTH_TOKEN (in .env.local) instead.
# LOOMCYCLE_ALLOW_OPEN_MODE=1
# The externally-reachable base URL for THIS instance (e.g. behind a tunnel/
# proxy). Advertised to agents via `Context op=self` (server.url) so an agent —
# especially one over the MCP transport — can identify the server it's talking
# to. Optional; unset → self reports only the bind address.
# LOOMCYCLE_PUBLIC_URL=https://loomcycle.example.com
# Web UI sign-in mode: token (default; paste a token) or strict (only the gates
# in the yaml `auth.gates` block). The stricter of this and the yaml's
# `auth.mode` holds: neither lowers the other.
# LOOMCYCLE_AUTH_MODE=token
# Strict mode only: allow Web UI sessions over plain HTTP (a cookie without
# Secure), e.g. on a tailnet. Behind a TLS terminator set an https://
# LOOMCYCLE_PUBLIC_URL instead. Warned at boot.
# LOOMCYCLE_UI_INSECURE_COOKIES=1
# Serve the Web UI from an unpacked UI bundle here (built SPA + manifest.json
# with each file's SHA-256 and supported API levels) instead of the built-in
# UI. Read at startup; a bundle failing verification is logged and the
# built-in UI served. Keep it operator-writable only: the UI runs with the
# operator's session.
# LOOMCYCLE_WEBUI_DIR=/srv/loomcycle/webui
# Instead of a directory: an https URL of a Web UI release archive (.tar.gz),
# fetched once through the egress guard, verified against
# LOOMCYCLE_WEBUI_BUNDLE_SHA256 and cached in LOOMCYCLE_DATA_DIR/webui. Not
# with LOOMCYCLE_WEBUI_DIR. A failed fetch is logged; the built-in UI is served.
# LOOMCYCLE_WEBUI_BUNDLE_URL=https://example.com/loomcycle-webui-1.0.0.tar.gz
# SHA-256 of that .tar.gz, 64 lowercase hex (from its .sha256 release asset).
# Required with LOOMCYCLE_WEBUI_BUNDLE_URL; nothing is unpacked unless it matches.
# LOOMCYCLE_WEBUI_BUNDLE_SHA256=<64 lowercase hex characters>

# ─── Storage ──────────────────────────────────────────────────────────
LOOMCYCLE_DATA_DIR=./data

# ─── Filesystem volumes (RFC AH Phase 3) ─────────────────────────────
#
# The file/exec tools (Read/Write/Edit/Glob/Grep/Bash/NotebookEdit) are
# sandboxed to named VOLUMES, declared in the YAML `volumes:` block — NOT
# via env vars. The legacy LOOMCYCLE_READ_ROOT / WRITE_ROOT / BASH_CWD jail
# is RETIRED: setting one stops the boot, with a pointer at `volumes:`.
# Sandbox-by-default — an agent bound to no volume has no disk access.
# To restore the old single shared jail, add to your loomcycle.yaml:
#   volumes:
#     default: { path: /srv/loomcycle/scratch, mode: rw, default: true }

# HTTP + WebFetch tools — comma-separated suffix-match host allowlist.
# Entry "example.com" matches "example.com" and "api.example.com" but
# not "evilexample.com". Private IPs (RFC1918, loopback, link-local incl.
# 169.254.169.254, CGNAT 100.64.0.0/10 and other non-public ranges) are
# HARD-blocked at connect regardless of allowlist.
# Loopback aliases on the list (localhost, 127.0.0.1, ::1, *.localhost)
# are silently stripped at startup — use LOOMCYCLE_HTTP_PRIVATE_HOST_ALLOWLIST
# below to permit specific loopback hosts.
# LOOMCYCLE_HTTP_HOST_ALLOWLIST=api.anthropic.com,api.brave.com,linkedin.com

# Private-host exception. Hosts here may resolve to private IPs at
# dial time — used to permit agent callbacks to a localhost-bound
# application API. Suffix-matched the same way as the main allowlist.
# Each entry must ALSO be on LOOMCYCLE_HTTP_HOST_ALLOWLIST (or be
# carried per-call when LOOMCYCLE_HTTP_CALLER_AUTHORITATIVE=1) to be
# reachable; this var only lifts the IP-private rejection.
# It is also the ONLY way a remote memory backend or document source
# authored at runtime (MemoryBackendDef / DocumentSourceDef) may reach a
# private host: list the peer's hostname here (no HTTP_HOST_ALLOWLIST entry
# needed for those). One declared in yaml keeps its own host without it.
# An entry may also be a CIDR range (100.64.0.0/10, 100.101.102.103/32): it
# admits only the resolved addresses inside that range, for any host name.
# "Private" includes CGNAT 100.64.0.0/10, so Tailscale peers (100.x IPs and
# MagicDNS names) need an entry here; 100.64.0.0/10 admits a whole tailnet.
# A malformed range fails startup.
# A host-name entry never admits a link-local address (169.254.0.0/16,
# fe80::/10) or a cloud metadata address (fd00:ec2::254, fd00:ec2::23,
# 100.100.100.200), whoever controls the name's DNS; only a CIDR entry
# covering the address does (e.g. 169.254.0.0/16); such an IP listed as a
# host entry fails startup.
# LOOMCYCLE_HTTP_PRIVATE_HOST_ALLOWLIST=localhost,127.0.0.1

# Private-host allowlist mode. any (the default): host-name and CIDR
# entries. cidr_only: CIDR entries only, so no private address is admitted
# on the say-so of a DNS answer; a host-name entry (or an IP written as a
# host entry) fails startup, as does any other value. cidr_only covers
# the yaml's hooks.private_host_allowlist too, stops vouching for a yaml
# remote peer by its host name, and puts the operator's MCP servers behind
# the guard (LOOMCYCLE_MCP_ALLOW_PRIVATE_IPS=1 then fails startup).
# LOOMCYCLE_HTTP_PRIVATE_HOST_ALLOWLIST_MODE=cidr_only

# Caller-authoritative mode for HTTP/WebFetch host allowlist.
# When unset (default): caller's per-request allowed_hosts can ONLY
# narrow the operator's static list. Trust model: operator owns the
# host policy; caller fine-tunes per-call.
# When =1: caller's allowed_hosts is the SOLE policy. Operator's
# static list becomes a fallback for runs that don't carry their own
# list. Trust model: caller (the application server) owns the host
# policy; operator's list is just a default. Use when the application
# manages a dynamic list of allowed hosts that changes faster than
# loomcycle restarts. IP-level guard at dial still applies.
# LOOMCYCLE_HTTP_CALLER_AUTHORITATIVE=1

# Bash tool — explicitly opt-in. NOT a true sandbox: cwd-restricted,
# env-scrubbed (only PATH leaks), output-bounded (1 MiB), time-capped
# (30s default, 5min max). Run loomcycle inside a container if you
# expose Bash to untrusted prompts. Bash requires a rw `volumes:` binding
# (it runs in the bound volume's root) — see the volumes note above.
# LOOMCYCLE_BASH_ENABLED=1

# ─── Client-tools — client-executed tools (RFC BC) ──────────────────
#
# The /v1/client-tools WebSocket lets a client (browser extension / desktop app)
# register + run tools on the USER'S machine; an agent granted `client:<tool>`
# calls them like any tool. The endpoint is bearer-gated + always available.
# One call blocks at most 60 s, a frame is at most 1 MiB, and a principal holds
# at most 8 connections. See `loomcycle help client-tools`.
#
# ─── Bashbox — TRUE in-process sandbox (RFC AJ, v1.3.0) ──────────────
#
# An alternative to Bash: a real sandbox (the pure-Go `gbash` engine) that
# spawns NO OS process, roots every path at the agent's mounted volume, and has
# NO network. Unlike Bash it HONORS read-only volumes (writes hit an in-RAM
# overlay, never the host). Always registered; grant it per agent via
# `tools: [Bashbox]`. gbash is alpha — the per-agent gate is the escape
# hatch.
#
# Host-command fallback (RFC AJ §13): an operator allowlist of commands gbash
# does NOT implement (e.g. git, gh) that may ESCAPE the sandbox to the real host
# shell. Empty (default) = no fallback; every command stays sandboxed. Only
# these names reach the host; requires a rw volume. Comma-separated.
# LOOMCYCLE_BASHBOX_FALLBACK_COMMANDS=git,gh
#
# Env vars injected ONLY into fallback (host) commands — never the sandbox
# (PATH always passes). The model CAN read them: an allowlisted command can
# print its environment (git -c alias.x='!env' x), so pass only values you
# would hand the model. Reference NAMES here; the secret VALUES live in
# .env.local. Comma-separated.
# LOOMCYCLE_BASHBOX_FALLBACK_ALLOWED_ENV=GH_TOKEN,HOME,SSH_AUTH_SOCK
#
# The model CAN read these too (see above). PER-TENANT credentials
# (CredentialDef names) injected into fallback commands, resolved for each
# run's own tenant/user/agent. `cmd:NAME` hands a credential to that one
# allowlisted command only (git:GITHUB_TOKEN,gh:GH_TOKEN); a bare NAME reaches
# every one. Overrides a same-named ALLOWED_ENV var. Requires
# LOOMCYCLE_SECRET_KEY (the credential KEK). Comma-separated.
# LOOMCYCLE_BASHBOX_FALLBACK_ALLOWED_CREDS=git:GITHUB_TOKEN,gh:GH_TOKEN
#
# Bytes one Bashbox call may write into memory: a read-only volume's writes
# and the shadowed dynamic root. Past it, writes fail with "no space left on
# device". Default 64 MiB; under 1 MiB is raised to 1 MiB.
# LOOMCYCLE_BASHBOX_OVERLAY_MAX_BYTES=67108864

# ─── Crypto tool ─────────────────────────────────────────────────────
#
# The Crypto tool encrypts, signs, MACs and makes one-time codes with keys the
# runtime holds (crypto keys stored with CredentialDef, which need
# LOOMCYCLE_SECRET_KEY). An agent uses keys only from the scopes its
# crypto_scopes grants. Each data argument is capped at 1 MiB and a run at 100
# calls.
#
# A crypto key can instead be held in Vault Transit, AWS KMS or Google Cloud
# KMS (CredentialDef create with backend + external). A Vault address must be
# on LOOMCYCLE_HTTP_HOST_ALLOWLIST or LOOMCYCLE_HTTP_PRIVATE_HOST_ALLOWLIST, and
# https unless this is set (a dev Vault on plain http; the Vault token travels
# in a header).
# LOOMCYCLE_KMS_VAULT_ALLOW_HTTP=1

# ─── Speech routes (read-aloud and transcription) ────────────────────
#
# POST /v1/audio/speech and POST /v1/audio/transcriptions put each engine
# request through a server-wide queue per direction: a self-hosted speech
# engine serves only a few requests at a time. A request over the bound
# WAITS for a slot while its caller stays connected; it is not refused. A
# long text or recording cut into pieces takes a slot per piece, so it takes
# turns with shorter requests. One setting sizes both queues. Default 2;
# takes a restart.
# LOOMCYCLE_AUDIO_MAX_INFLIGHT=2

# Confinement for the helper commands (transcription.ocr.rasterize,
# transcription.stt.media, speech.encode). Without it they run as the
# loomcycle user and can read what it can. Words split like a helper command
# (no shell, no placeholders); the helper's program and arguments are
# appended as argv. The helpers write under the inbox root (the volume
# marked dynamic_root) and TMPDIR (the /v1/audio routes), so a sandbox must
# bind both writable. ffmpeg always runs with -nostdin and
# -protocol_whitelist file,pipe.
# LOOMCYCLE_HELPER_WRAPPER=bwrap --ro-bind / / --dev /dev --bind /tmp /tmp --bind <inbox root> <inbox root> --unshare-net --die-with-parent --

# ─── Skills (v0.4.0+) ────────────────────────────────────────────────
#
# Directory holding `<name>/SKILL.md` skill files (Approach A in
# doc-internal/skills-design.md). Each agent's `skills:` YAML field
# names skills under this root; loomcycle parses the SKILL.md
# frontmatter, validates `allowed-tools` is a subset of the bundling
# agent's `tools`, and concatenates the body onto the agent's
# system_prompt at config-load. The bundled body lands inside the
# cacheable system block, so subsequent runs replay at cache-read
# rates.
#
# When unset, agents may NOT list skills (config-load fails with a
# named error rather than silently dropping the skill body). When set
# but empty/missing, config-load reports the unreadable directory.
#
# Unset, the root is <LOOMCYCLE_CONFIG_DIR>/skills when that directory
# exists. Set it to the empty string to load no skills directory at all.
#
# Skill bodies count as operator-authored content and are trusted —
# they're loaded with the same trust as inline `system_prompt:`. Do
# not point this (or the config dir) at a directory writable by
# untrusted users.
# LOOMCYCLE_SKILLS_ROOT=/srv/loomcycle/skills

# ─── Agent directory discovery (v0.8.x+) ─────────────────────────────
#
# Directory of flat `<name>.md` files. When set, loomcycle parses each
# file's YAML frontmatter as the base AgentDef and the body (after the
# closing `---`) as the system prompt. The yaml `agents:` map remains
# OPTIONAL and acts as an override layer — yaml entries with the same
# name override per-field. Operators get a single source of truth in
# the MD with targeted per-environment tweaks in yaml when needed.
#
# Why: synchronising the yaml `agents:` block with the MDs referenced
# from `system_prompt_file` is recurring operational pain (every
# dev↔main branch divergence breaks loomcycle on the deploy box).
#
# Frontmatter contract — these top-level keys are read by loomcycle
# (Claude Code ignores unknown keys, so the same MD drives both):
#   name                  # string; must equal filename sans .md
#   description           # string; informational
#   tools                 # string "A, B, C" OR list [A, B, C]
#   provider              # string; e.g. anthropic / openai / deepseek
#   model                 # string; alias or full model ID
#   tier                  # one of low / middle / high
#   models                # map<tier-name, [{provider, model}, ...]>
#   effort                # one of low / medium / high
#   max_tokens            # int; per-iteration output cap
#   skills                # list of skill names (LOOMCYCLE_SKILLS_ROOT)
#   memory_scopes         # list — subset of {agent, user, tenant}; unset = the caller's own data
#   memory_quota_bytes    # int; per-agent override
#   providers             # list — per-agent ProviderPriority override
#   system_prompt_file    # string; alternative to body
#
# Validation rules (Pin XOR Tier, Effort domain, MemoryScopes domain,
# etc.) run unchanged on the merged map. A typo'd key is silently
# dropped to zero today — keep that in mind when an agent doesn't
# behave as expected.
#
# Unset, the root is <LOOMCYCLE_CONFIG_DIR>/agents when that directory
# exists; in that defaulted directory a .md file with no frontmatter is
# skipped (it is a prompt body or a README, not an agent) and the boot
# logs each one. To discover no agent files, point it at an empty
# directory.
# LOOMCYCLE_AGENTS_ROOT=/srv/loomcycle/agents

# ─── Help topics (v0.8.8+) ───────────────────────────────────────────
#
# Loomcycle ships a small bundled set of help topics embedded in the
# binary (loomcycle, scopes, subagents, experimentation, system-channels).
# These are returned by the Context.help op:
#
#   {"op": "help"}              # index — name + description per topic
#   {"op": "help", "topic": "scopes"}  # full markdown body of one topic
#
# Operators MAY point LOOMCYCLE_HELP_ROOT at a directory of `<name>.md`
# files. Files in that directory follow the same frontmatter format
# (`name:` must match the filename stem; `description:` is the index
# one-liner; everything after the closing `---` is the body). A
# filesystem topic with a name matching a bundled topic OVERRIDES the
# bundled one — useful for replacing default guidance with deployment-
# specific docs without rebuilding the binary.
#
# Tool articles live in a `tools/` subdirectory: `tools/<Tool>.md` is the
# article for a tool, `tools/<Tool>/<op>.md` one of its operations, and
# <Tool> is the tool's name exactly as the model sees it — so an operator
# can document an MCP tool as `tools/mcp__<server>__<tool>.md`. A tool with
# an article gets a one-line pointer to it in its description, for every
# run that holds the Context tool. Examples go in ```json fences under an
# `## Examples` heading; an article missing them still loads, with a
# warning in the log.
#
# Unset, the root is <LOOMCYCLE_CONFIG_DIR>/help when that directory
# exists; otherwise only the bundled topics are served. Set it to the
# empty string for bundled topics only.
#
# LOOMCYCLE_HELP_ROOT=/srv/loomcycle/help

# ─── Memory tool (v0.8.0+) ───────────────────────────────────────────
#
# The Memory tool exposes persistent agent-scoped key/value storage to
# the model (get / set / delete / list / incr). Storage rides the
# existing Store backend (sqlite default, postgres opt-in).
#
# Per-agent yaml gates which scopes an agent may use:
#   memory_scopes: [agent, user]          # unset = the caller's own data (user, plus tenant
#                                         # for a non-isolated tenant member). For no Memory,
#                                         # leave Memory out of `tools`.
#   memory_quota_bytes: 5_000_000         # optional override; 0 = use default
#
# One value (set / incr) is capped at 64 KiB.

# Default per-(scope, scope_id) byte cap. Default 1 MB (1048576).
# 0 disables. Per-agent yaml memory_quota_bytes overrides this.
# LOOMCYCLE_MEMORY_MAX_SCOPE_BYTES=1048576

# Drained consolidation-queue rows are deleted once they have been drained
# longer than this. A queued row keeps the raw chat it was banked from, so
# this is also how long that text outlives its consolidation. Undrained rows
# are never pruned. Default 7 days (604800000). 0 disables the prune.
# LOOMCYCLE_MEMORY_PENDING_DRAINED_TTL_MS=604800000

# ─── SQL Memory (RFC AA, v1.2.0) — and the Document primitive ────────
#
# A per-scope SQL database the runtime hosts as a third Memory facet (agents
# query arbitrary SQL via the Memory tool's sql_* ops). It also BACKS the
# Document primitive (RFC AK) — the chunk-structure tables live here, so
# **Documents and the Web UI Document viewer/assistant require it.**
# On with a SQLite store. With a Postgres store it is on when
# LOOMCYCLE_SQLMEM_PG_DSN is set. `storage.sqlmem_enabled: false` in the
# yaml turns it off.
#
# Per-scope ACL is per-agent yaml: `sql_scopes: [agent, user]` (empty = no SQL).
#
# Where the per-scope sqlite files live (default <DataDir>/sqlmem). Postgres
# tier: set the DSN in .env.local (LOOMCYCLE_SQLMEM_PG_DSN — it carries a
# password, so it is a SECRET, not config).
# LOOMCYCLE_SQLMEM_ROOT=./data/sqlmem
#
# The query guardrails (row and byte caps, statement and transaction timeouts,
# open-transaction caps, savepoint depth) have fixed defaults; a deployment
# that needs another value sets the yaml `storage: sqlmem_*` key.
# LOOMCYCLE_SQLMEM_QUOTA_BYTES=52428800        # default per-scope DB byte cap (per-agent sql_quota_bytes overrides)
# LOOMCYCLE_SQLMEM_TOTAL_MAX_BYTES=0           # global cap across all scope DBs (0 = unbounded)
# LOOMCYCLE_SQLMEM_SCOPE_TTL_MS=0              # evict a scope DB idle this long (0 = never)
# LOOMCYCLE_SQLMEM_AUDIT_MODE=metadata         # full (default) audits each statement, redacted; metadata audits only that it ran
# LOOMCYCLE_SQLMEM_SHARED_SCHEMAS=             # comma-separated shared-schema names (advanced)

# ─── Vector Memory (semantic recall) ────────────────────────────────
#
# Memory op=recall does embedding-based semantic search. sqlite tier uses
# sqlite-vec; postgres tier uses pgvector. The embedder API key (if a hosted
# embedder) is a SECRET → .env.local.
# LOOMCYCLE_PGVECTOR_ENABLED=1                 # use pgvector on the postgres backend
# LOOMCYCLE_SQLITE_VEC_PATH=                   # path to the sqlite-vec extension (.so/.dylib), if not auto-found
# The embedder's batch size and call timeout are memory.embedder.batch_size /
# timeout_ms in the yaml.

# ─── Provider streaming timeouts ─────────────────────────────────────
#
# Set per provider in the yaml, under `providers.<id>.options`:
#   header_timeout_ms   time to the response headers (default 60000; the
#                       local Ollama provider 600000, since it sends no
#                       headers until the model is loaded)
#   idle_timeout_ms     longest silence inside a stream (default 90000;
#                       local Ollama 600000)
# Neither can be disabled.

# ─── Model throughput measurement (timeout_scaling) ──────────────────
#
# loomcycle times every model call and keeps, per (provider, model), how much
# slower than a reference machine the model runs (100 output tok/s, 2000
# prompt tok/s, 1 s to first token). It reports that slowdown on
# GET /v1/_routing, /metrics and Context op=self, with the timeout multiplier
# it implies. `measure` (the default) records and reports only — NO timeout
# changes. `off` stops measuring. (`on` is not available yet.) All of it is
# set in the yaml `timeout_scaling:` block (mode, reference, max_multiplier,
# min_samples, local_prior, per-model overrides); there are no variables.

# ─── Provider fallback semantics (v0.8.13+) ──────────────────────────
#
# Cross-provider runtime fallback (v0.8.2) climbs through the user_tier
# candidate list on retryable errors. Mid-conversation fallback can
# trip provider-specific transcript translation bugs (DeepSeek
# reasoning_content, Anthropic cache_control, Gemini thoughtSignature,
# tool_call shape differences). Each requires its own translation
# layer; the surface area grows over time.
#
# When this flag is set to "1", fallback is SUPPRESSED after the run
# has completed at least one successful turn. The initial turn can
# still fall back (so a stale-probe initial pick doesn't kill the
# run). Once the transcript has provider-specific state, the run
# stays on its current provider. Same-provider rate-limit retry
# (internal/providers/ratelimit/) still covers transient errors
# within one provider.
#
# Trade: a sustained outage of a provider mid-conversation will fail
# the run instead of cascading to a fallback. Acceptable for most
# production deployments — provider outages are rare and clients
# retry; mid-conversation translation bugs are subtle and silent.
#
# When fallback is suppressed, loomcycle emits the typed event
# `fallback_suppressed` on the SSE wire so operators can attribute
# the failure to the policy rather than the resolver.
#
# Default OFF. Recommended for any deployment running runs
# with thinking-mode providers (DeepSeek reasoner family,
# gemini-2.5-flash with effort hint).
# LOOMCYCLE_FALLBACK_PIN_AFTER_SUCCESS=1

# ─── Process-resource metrics sampler (v0.8.x+) ──────────────────────
#
# Built-in CPU + memory sampler that runs as a background goroutine
# while at least one agent run is active and persists samples to a
# new `process_samples` table for capacity-planning. Sleep-when-idle:
# no DB writes, no /proc reads when nothing is running.
#
# Default OFF. The sampler is the yaml `metrics:` block:
#   metrics:
#     enabled: true
#     sample_interval: 5s    # default 5s; at least 1s. Storage at the
#                            # default: ~210 MB/week when always active
#     collect_system: true   # also read /proc/stat + /proc/meminfo for
#                            # SYSTEM-wide CPU% + memory (Linux only)
#
# Retention in days. Default 7. Set 0 to disable automatic cleanup
# (table grows unbounded). Lower this on slow disks or
# storage-constrained deployments.
# LOOMCYCLE_METRICS_RETENTION_DAYS=7
#
# Public API (bearer-authed):
#   GET /v1/_metrics/samples?since=<RFC3339>&until=<RFC3339>&limit=N
#   GET /v1/_metrics/runs/{run_id}    — peak/mean RSS + max CPU%
#                                       for samples in the run window
#   GET /v1/_metrics/summary?period=1h|24h|7d
#                                     — aggregated buckets

# ─── LoomCycle MCP / dynamic agents (v0.8.15+) ───────────────────────
#
# v0.8.15 introduced the `loomcycle mcp --config Y` subcommand: an
# alternate front-end that exposes MCP tools over stdio so
# orchestrators like Claude Code can drive loomcycle directly. See
# `loomcycle-mcp.sh` at the repo root for the wrapper script that
# Claude Code's .mcp.json should reference (sources .env.insecure +
# .env.local then execs the binary).
#
# Dynamically-registered agents may by default NOT request the
# privileged builtins (Bash, Bashbox, Write, Edit) in their tools —
# those are stripped silently from the request. Operator opts in by
# setting this to 1, after which dynamic agents can request any
# builtin the operator's yaml exposes. Mirrors the v0.8.7/v0.8.8
# default-deny pattern for new tool surfaces.
#
# IMPORTANT: only flip on when the MCP client itself is trusted
# (operator-launched stdio = trusted; remote HTTP MCP would not be).
# LOOMCYCLE_MCP_ALLOW_PRIVILEGED_TOOLS=1
#
# By default the MCPServerDef substrate (POST /v1/_mcpserverdef) may
# register only http / streamable-http servers; a `stdio` server runs an
# ARBITRARY LOCAL COMMAND, so dynamic stdio registration is off by default
# (a second local-exec path alongside the Bash tool). Set this to 1 to let
# operators register stdio MCP servers at runtime with command/args/env.
# Static yaml `mcp_servers:` stdio entries are always allowed regardless.
# LOOMCYCLE_MCP_ALLOW_DYNAMIC_STDIO=1
#
# A runtime MCP server def may hold a ${NAME} env reference only when an admin
# saved it. A stored def that holds one without that record (written before
# the rule, restored from an older snapshot, or edited by hand) is NOT dialed by
# default; a boot WARNING lists each one. An admin re-save in that tenant
# (create with the same overlay) restores it. Set this to 0 to dial those defs
# anyway while the re-saves are pending (one WARNING per def when dialed);
# unset, 1, or an unrecognised value refuses.
# LOOMCYCLE_MCP_REFUSE_UNATTRIBUTED_ENV=0
#
# F32 — secret redaction at rest. ON BY DEFAULT: tool I/O (tool_call inputs +
# tool_result outputs) is scanned for secret-shaped substrings and masked
# BEFORE it is persisted to the events store (and thus to snapshots + the
# /v1/_events audit API), so a token inlined on a Bash cmdline or echoed by a
# tool isn't written to disk in cleartext. The live SSE stream is NOT redacted
# (the caller already holds the secret). Set to 0 to DISABLE redaction (e.g. to
# debug a transcript locally). Note: this is defense-in-depth — agents should
# still pass secrets out-of-band (env / stdin / credential helper), never inline.
# LOOMCYCLE_REDACT_SECRETS=0
#
# An agent registered via mcp__loomcycle__register_agent lives 24 h unless
# the caller names ttl_seconds (-1 = no expiry: the operator must unregister).
#

# ---- v0.8.17 Pause / Resume / Snapshot ---------------------------------
# Runtime-wide quiesce + cross-version-portable JSON snapshot. Operators
# drive via /v1/_pause / /v1/_resume / /v1/_state HTTP endpoints OR the
# matching CLI subcommands (loomcycle pause / resume / state / snapshot
# / snapshots list/export/delete / restore). Agents never call these
# directly. The pause Manager is always constructed (cheap; one atomic
# + one channel) — no env flag is needed to ENABLE the feature.
#
# A pause waits 30 s for in-flight runs to park unless POST /v1/_pause names
# timeout_ms (at most 5 min).

# On SIGTERM / SIGINT, pause this replica's in-flight runs so the next boot
# resumes them, waiting at most this long. At 3/4 of it, the tool calls of runs
# not yet parked are interrupted (a Bash command's process group is killed).
# 0 = no pause. The default leaves room in Docker's 10 s stop grace; raise it
# with stop_grace_period / terminationGracePeriodSeconds.
# LOOMCYCLE_SHUTDOWN_PAUSE_TIMEOUT_MS=7000

# ---- RFC H inbound webhooks --------------------------------------------
# External systems (GitHub/Gitea/Stripe/Linear/CI/n8n) trigger agent runs
# or wake parked agents via signed POST /v1/_webhooks/{name}. Always
# mounted; with no WebhookDef the route matches nothing.
#
# Secret resolution: a webhook's signing_secret_env / bearer_token_env /
# user_credentials_from_env env-var NAMES must be authorized, or every
# delivery 503s `unavailable` (the log names the env var). (The NAMES are config and live
# here; the secret VALUES live in .env.local.) A name is authorized
# when ANY of:
#   1. it is LOOMCYCLE_*-prefixed (or a known third-party name) — auto-
#      allowed for the VERIFY secret only (consumed by the receiver, never
#      reaches the agent). So signing_secret_env: LOOMCYCLE_X Just Works.
#   2. it is declared by a STATIC (yaml) webhook — auto-trusted.
#   3. it is listed here (comma-separated) or in the scheduler's shared
#      LOOMCYCLE_SCHEDULER_ENV_ALLOWLIST. REQUIRED for a runtime
#      (webhookdef-tool) def's non-LOOMCYCLE_ credential env names — those
#      do NOT get the namespace auto-allow (they reach the agent).
# LOOMCYCLE_WEBHOOKS_ENV_ALLOWLIST=GITEA_WEBHOOK_SECRET,STRIPE_WH_SECRET
#
# Trusted-network ingress: honor `auth.kind: none` (skip HMAC) for a
# receiver only reachable over an already-authenticated transport
# (WireGuard/tailnet, mTLS). Default OFF — a none-auth webhook 503s
# `unavailable` (the log says why) until this is set.
# LOOMCYCLE_WEBHOOKS_ALLOW_UNAUTHENTICATED=1
#
# Shared trigger-credential allowlist (also gates scheduled-run
# user_credentials_from_env). Merged with LOOMCYCLE_WEBHOOKS_ENV_ALLOWLIST.
# LOOMCYCLE_SCHEDULER_ENV_ALLOWLIST=GITEA_API_TOKEN

# ═══════════════════════════════════════════════════════════════════════
#  Additional subsystems (all default-OFF or sensibly-defaulted; set only
#  what you need). Secret VALUES (DSNs, signing keys, the token pepper,
#  provider API keys, bearer tokens) always live in .env.local — only their
#  non-secret toggles/NAMES belong here.
# ═══════════════════════════════════════════════════════════════════════

# ─── gRPC transport ──────────────────────────────────────────────────
# Second wire surface alongside HTTP+SSE. Unset = gRPC server off.
# LOOMCYCLE_GRPC_ADDR=127.0.0.1:8788

# ─── Storage backend / Postgres (RFC I) ──────────────────────────────
# Default sqlite (file under LOOMCYCLE_DATA_DIR). A set LOOMCYCLE_PG_DSN
# selects Postgres, the production backend; the DSN itself is a SECRET →
# .env.local. Same for the SQL Memory PG DSN (LOOMCYCLE_SQLMEM_PG_DSN).
# If the data dir already holds a SQLite store, a DSN alone does not switch
# stores: the boot stops until storage.backend in the yaml says which.
# LOOMCYCLE_PG_AUTOMIGRATE=1            # run schema migrations on boot
# LOOMCYCLE_PG_MAX_OPEN_CONNS=20
# LOOMCYCLE_PG_MIN_IDLE_CONNS=2

# ─── Scheduler (RFC E) ───────────────────────────────────────────────
# Fires ScheduleDef cron/at runs. Always on; with no ScheduleDef nothing
# fires. (Trigger-credential allowlist is LOOMCYCLE_SCHEDULER_ENV_ALLOWLIST,
# above.)
# LOOMCYCLE_SCHEDULER_TICK_SECONDS=30          # poll cadence for due schedules (default 30)

# ─── A2A — agent-to-agent interop (RFC G) ────────────────────────────
# Inbound A2A server + outbound client. Off by default; naming the server
# card turns both on.
# LOOMCYCLE_A2A_SERVER_CARD=public                         # NAME of the active server card (a2a_server_cards / A2AServerCardDef); setting it enables A2A
# LOOMCYCLE_A2A_PUBLIC_BASE_URL=https://agents.example.com  # advertised in the server card
# LOOMCYCLE_A2A_TENANCY_ROUTING=path                        # how the inbound tenant is derived: none (default) | host | path

# ─── Channel tool tuning (RFC S) ─────────────────────────────────────
# Fan-in/out bus for ensemble coordination. The `channels:` yaml block declares
# targets. A message is capped at 64 KiB.
# LOOMCYCLE_CHANNELS_LONGPOLL_CAP_MS=30000     # max Channel.await long-poll wait

# ─── Interruption (human-in-the-loop) ───────────────────────────────
# Configured in the yaml `interruption:` block, not by env vars:
#   interruption:
#     backend: webui            # the default
#     default_timeout_ms: 3600000
#     max_timeout_ms: 86400000
#     max_pending_per_run: 10
# (No LOOMCYCLE_INTERRUPTION_* variable is read.)

# ─── Pause / Resume / Snapshot (RFC X) extras ────────────────────────
# A snapshot's size cap is per capture (`max_bytes` on the request), default
# 512 MB. No env var sets it.

# ─── Multi-replica / HA ──────────────────────────────────────────────
# Cross-replica cancel + pause + session locks, carried over the Postgres
# store (LOOMCYCLE_PG_DSN); there is no separate bus to configure. Setting
# LOOMCYCLE_REPLICA_ID is what turns cluster mode on.
# LOOMCYCLE_REPLICA_ID=replica-a              # stable id, unique per replica (default: unset = single replica)
# LOOMCYCLE_REPLICAS_STALE_AFTER_MS=90000     # mark a replica dead after silence (default 90s)
# LOOMCYCLE_REPLICAS_SWEEP_INTERVAL_MS=60000  # dead-replica sweep cadence (default 60s)
# LOOMCYCLE_HEARTBEAT_STALE_MS=600000         # reap a run with no heartbeat this long

# ─── OpenTelemetry (traces) ──────────────────────────────────────────
# The standard OTEL_* variables. An OTLP endpoint (a URL with its scheme)
# enables tracing. Collector auth headers are a SECRET → put
# OTEL_EXPORTER_OTLP_HEADERS in .env.local, or point
# LOOMCYCLE_OTEL_EXPORTER_OTLP_HEADERS_FILE at a file holding them.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf    # or grpc (endpoint :4317)
# OTEL_SERVICE_NAME=loomcycle
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=replica-a
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1                  # 0.0–1.0 sample fraction
# LOOMCYCLE_OTEL_EXPORTER_OTLP_HEADERS_FILE=/run/secrets/otel-headers
# LOOMCYCLE_OTEL_INBOUND_CONTEXT=parent        # parent | link | ignore
# LOOMCYCLE_ENVIRONMENT=production             # deployment.environment.name
# LOOMCYCLE_TRACE_URL_TEMPLATE=https://grafana.example/explore?traceId={trace_id}

# ─── Prometheus scrape listener ──────────────────────────────────────
# A second plain-HTTP listener serving GET /metrics only, with NO
# authentication, for a scraper on this host or a protected network
# (a compose network). Unset = off; the main listener's /metrics still needs
# a metrics:read (or admin) token.
# LOOMCYCLE_METRICS_LISTEN=127.0.0.1:9464

# ─── Auth tuning (RFC L; the AUTH_TOKEN + token pepper are SECRETS) ──
# LOOMCYCLE_AUTH_CACHE_TTL_SECONDS=30                   # operator-token lookup cache TTL (default 30; 0 disables)
# Access-control mode: compat (default), shadow or enforce; read at startup.
# compat: the scope gates decide, plus any deny bound to the caller. shadow:
# the gates decide and each disagreement with the rules is logged
# (acl_shadow_diverged); run it before enforce. enforce: the rules decide
# (403 acl_denied; 503 acl_unavailable when they cannot be read).
# LOOMCYCLE_ACL=compat                                # RFC EY access-control mode: compat (default) | shadow | enforce
# How long a replica trusts a caller's compiled access rules before re-reading
# them (default 5 seconds; 0 = on every request).
# LOOMCYCLE_ACL_CACHE_TTL_SECONDS=5                   # how long a replica trusts a compiled ACL set before re-reading the tenant version
# 1 = per-user and gate-issued tokens take their scopes from the user's
# CURRENT access_mode on every request (promote or demote with no re-mint).
# Unset = frozen at mint, as before; operator tokens are always frozen.
# LOOMCYCLE_TOKEN_AUTHORITY_INHERIT=1                 # per-user + gate-issued tokens follow the user's CURRENT access_mode (default: frozen at mint)
# A run in flight follows its caller's access rules as they change: what they
# no longer allow is withdrawn at the next model or tool call, and nothing the
# run started without is given (default off: the rules a run starts with hold
# until it ends).
# LOOMCYCLE_ACL_LIVE=1                                # re-read a run's caller rules during the run (default off)
# LOOMCYCLE_OPERATOR_TOKEN_ROTATION_GRACE_SECONDS=86400 # accept a rotated-out token this long (default 24h)
# LOOMCYCLE_USER_TOKEN_MAX_TTL_SECONDS=86400            # longest life a per-user token may be minted with; a mint asking for none gets this (default: no cap)
# LOOMCYCLE_RUN_RATE_PER_MINUTE=60                      # default rate for run starts, for a token that carries none (default: no rate; operators are never bound by it)
# LOOMCYCLE_RUN_RATE_BURST=120                          # how many starts are allowed at once from idle (default: the per-minute value)
# LOOMCYCLE_LIMITS_ENFORCE=strict                       # a hard token budget also stops runs in flight and refuses sub-agents (default: checked only when a run starts)
# RFC AX operator-key restriction (default OFF). When ON, a run whose principal
# lacks the `providers:operator-key` scope may NOT fall back to the operator's
# host provider key — it routes only to providers the tenant can key itself (an
# RFC AR CredentialDef) and is refused 403 if none. Off ⇒ byte-identical for
# every existing token. NON-secret feature flag.
# LOOMCYCLE_OPERATOR_KEY_RESTRICTION=1

# ─── MCP tuning ──────────────────────────────────────────────────────
# (MCP_ALLOW_PRIVILEGED_TOOLS / MCP_ALLOW_DYNAMIC_STDIO are documented above;
# the upstream bearer LOOMCYCLE_MCP_UPSTREAM_TOKEN is a SECRET → .env.local.)
# LOOMCYCLE_MCP_SPAWN_RUN_TIMEOUT_MS=0         # per spawn_run cap over MCP (0 = none)
# LOOMCYCLE_MCP_RECIPES_ROOT=/srv/loomcycle/recipes  # optional MCP recipe dir

# ─── Concurrency / runtime knobs ─────────────────────────────────────
# (The run, per-user and provider-queue limits are the yaml `concurrency:`
# block: max_concurrent_runs_per_user, max_queued_runs_per_user,
# provider_queue_depth.)
# A top-level interactive run parked for its operator ends after this long with
# no message (stop reason idle_timeout). Its session is kept: the next message
# continues it. A Go duration; 0 waits forever. Default 1h.
# LOOMCYCLE_INTERACTIVE_IDLE_TIMEOUT=1h
# How long a batch in mode join (POST /v1/runs:batch, MCP spawn_runs, gRPC
# SpawnRunBatch) waits for its children when the request gives no timeout_ms.
# Past it the join only stops waiting: no child is cancelled. Each child still
# going comes back running (or queued) with its run_id and an error saying the
# join timed out, and goes on; only a request's own timeout_ms cancels. A Go
# duration; 0 = no server bound.
# Default 1h.
# LOOMCYCLE_BATCH_JOIN_TIMEOUT=1h

# ─── Git sources (a volume filled with one commit of a repository) ───
# Off unless hosts are listed. `VolumeDef op=create ephemeral:true source:{git:…}`
# then fetches the commit inside the runtime, so no agent holds the token. The
# agent needs "source:git" in volume_def_scopes, and a credential it names must
# be restricted (allowed_urls) to a URL covering the repository.
# LOOMCYCLE_GIT_SOURCE_HOSTS=github.com,gitea.example.com   # hosts a repository may be fetched from (unset = the feature is off)
# LOOMCYCLE_GIT_PUSH_HOSTS=github.com                        # hosts the Git tool may push to (unset = no push); clone/fetch/pull use LOOMCYCLE_GIT_SOURCE_HOSTS
# LOOMCYCLE_GIT_AUTHOR_NAME=loomcycle-bot                    # author and committer name of the Git tool's commits (default: the agent's name)
# LOOMCYCLE_GIT_AUTHOR_EMAIL=bot@example.com                 # their email (default: <agent>@loomcycle.invalid)

# ─── Files tools return (the run inbox) ─────────────────────────────
# A file a tool returns (an MCP attachment or image) is kept in the run tree's
# inbox volume, under the dynamic_root volume, and the model is handed a
# one-line reference instead of the bytes. Deleted with the run. Needs a
# volume marked dynamic_root: true; without one a file is refused, not passed
# through. A bad value refuses the boot.
# LOOMCYCLE_FILE_MAX_BYTES=67108864           # one kept file (default 64 MiB)
# LOOMCYCLE_FILE_INBOX_MAX_BYTES=1073741824   # a run tree's whole inbox (default 1 GiB)
# LOOMCYCLE_MCP_MAX_FRAME_BYTES=16777216      # one MCP response: a stdio line or an HTTP body (default 16 MiB)
# LOOMCYCLE_EXTRACT_CONCURRENCY=4             # File extractions (extract, import, OCR page cuts) the process runs at once; the rest wait (default: GOMAXPROCS)

# ─── Sub-agent limits (the Agent tool) ───────────────────────────────
# Children one run has alive at once, across every Agent op that starts one; a
# spawn past it is refused. Per run, not per tree: a child's children count
# against the child. Default 32.
# LOOMCYCLE_MAX_LIVE_CHILDREN_PER_RUN=32
# Resident (op=open) children one run holds open at once; op=open past it is
# refused until one is closed. Default 8.
# LOOMCYCLE_MAX_INTERACTIVE_CHILDREN=8
# A resident child is reaped after 30 min with no send, or when its current
# turn has run 2 h. One Agent poll with wait any/all blocks at most 60 s.

# ─── code-js provider (RFC J) — synthetic, deterministic, zero-cost ──
# A goja-backed provider for stateless replay agents (load tests, deterministic
# pipelines). Always registered; an agent uses it with `provider: code-js`.
# LOOMCYCLE_CODE_AGENTS_ROOT=/srv/loomcycle/code-agents   # dir of <name>.js agents
# Its budgets are yaml options, under `providers.code-js.options`:
# deterministic, run_timeout_seconds (default 120), max_wall_seconds (86400).

# ─── mock provider (cost-free load tests) ────────────────────────────
# Canned responses with tunable latency/error injection — never hits a real API.
# LOOMCYCLE_MOCK_ENABLED=1
# LOOMCYCLE_MOCK_LATENCY_MS=200
# LOOMCYCLE_MOCK_LATENCY_JITTER_MS=50
# LOOMCYCLE_MOCK_429_RATE=0.0          # fraction of calls returning 429 (rate-limit)
# LOOMCYCLE_MOCK_500_RATE=0.0          # fraction returning 500

# ─── Anthropic OAuth (subscription) — RESEARCH/DEV ONLY ──────────────
# Reverse-engineered subscription billing (see docs/PROVIDERS.md + the
# bundles/document-agent/loomcycle_oauth.yaml variant). Opt-in flag here; tokens
# persist at ~/.config/loomcycle/anthropic-oauth.json after `loomcycle anthropic
# login`. Off by default → the `anthropic-oauth-dev` provider is absent.
# LOOMCYCLE_ANTHROPIC_OAUTH_DEV_ENABLED=1
# LOOMCYCLE_ANTHROPIC_OAUTH_CALLBACK_PORT=8788  # local browser-login callback port

# ─── Audit ───────────────────────────────────────────────────────────
# Optional path for a structured audit log (in addition to the events store).
# LOOMCYCLE_AUDIT_LOG_PATH=/var/log/loomcycle/audit.log
