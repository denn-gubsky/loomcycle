# Dockerfile.worker — goreleaser variant: the loomcycle binary as a conversion
# worker (RFC GO, conversion.mode remote), with the helper programs the
# conversions run: ffmpeg (a recording to a WAV for speech-to-text, speech to
# Opus or MP3), poppler's pdftoppm (a PDF page to an image for OCR), Typst
# (a Document rendered as a PDF, RFC GR), with Noto Sans, Noto Sans Mono and
# Noto Serif for its text (Latin, Cyrillic, Greek) and, for a house style
# that names them (RFC HB D1), Inter, Carlito (Calibri's metrics) and
# Liberation Sans and Serif (Arial's and Times New Roman's), merman (a Mermaid
# diagram drawn as a picture, RFC GR P4d; no browser), and DjVuLibre's
# djvutxt and djvused (a DjVu book's text layer, outline and metadata, RFC
# GV P3) and ddjvu (its pages rendered for OCR, RFC GV P4).
#
# A worker holds no provider key, no store connection and no volume: it dials
# the runtime's worker endpoint (--dispatcher, or LOOMCYCLE_WORKER_DISPATCHER
# below), receives a file's bytes, converts them in its scratch directory and
# sends the result back. Run it with a memory limit, a read-only root, a tmpfs
# at /scratch and no volume mounts; a file that exhausts the limit kills this
# container, not the runtime, and is not sent to another worker.
#
# The helper commands below are the ones docs/WORKERS.md recommends; set the
# variables to override them. Each is run without a shell, with a scrubbed
# environment, in /scratch.
#
# Debian slim rather than distroless: ffmpeg and poppler bring shared
# libraries. The same pre-built binary as Dockerfile.release (goreleaser
# builds every arch; this only COPYs it) and the same nonroot uid 65532.
# Debian 13 (trixie), not 12: merman's release binary needs glibc 2.38 and
# bookworm has 2.36 (RFC GR P4d).
#
# Two targets. The default (the last stage) is the conversion worker above.
# `ws-worker` adds the docker client for a workspace worker on the container
# engine (RFC GW P3): `loomcycle worker --role workspace` with
# LOOMCYCLE_WORKSPACE_ENGINE=container drives the host's daemon through its
# socket. Published as loomcycle-ws-worker.

# The docker client only; docker:cli's binary is static, so it runs on Debian.
FROM docker:cli@sha256:34507eb5069d8be82c95dd3b6987d4250fd5fee49b82e2509b7d7a7030740d6d AS docker-cli

FROM debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS worker

# Typst is a pinned release, its archive checked against the sha256 GitHub
# publishes for it, one per architecture. It never fetches a package: the
# source loomcycle writes imports nothing.
ARG TARGETARCH
ARG TYPST_VERSION=0.15.1
ARG TYPST_SHA256_AMD64=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c
ARG TYPST_SHA256_ARM64=5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee
# merman-cli likewise: a pinned release, checked against its published
# sha256. It reads a diagram's text and writes a PNG; it fetches nothing.
ARG MERMAN_VERSION=0.9.3
ARG MERMAN_SHA256_AMD64=e93dbf741319190d53107c4277b373d357dcdad3f4f7e50f114a51c9b682109b
ARG MERMAN_SHA256_ARM64=afea2472d232d0642b430f1db03a8d216925fbad04144348c2fe0838069c7f54

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg poppler-utils fonts-noto-core fonts-noto-mono \
        fonts-inter fonts-crosextra-carlito fonts-liberation curl xz-utils djvulibre-bin; \
    case "${TARGETARCH:-amd64}" in \
        amd64) triple=x86_64-unknown-linux-musl; sum="${TYPST_SHA256_AMD64}" ;; \
        arm64) triple=aarch64-unknown-linux-musl; sum="${TYPST_SHA256_ARM64}" ;; \
        *) echo "no Typst pin for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/typst.tar.xz "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${triple}.tar.xz"; \
    echo "${sum}  /tmp/typst.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/typst.tar.xz -C /tmp; \
    install -m 0755 "/tmp/typst-${triple}/typst" /usr/local/bin/typst; \
    install -d /usr/share/doc/typst; \
    install -m 0644 "/tmp/typst-${triple}/LICENSE" /usr/share/doc/typst/LICENSE; \
    rm -rf /tmp/typst.tar.xz "/tmp/typst-${triple}"; \
    typst --version; \
    case "${TARGETARCH:-amd64}" in \
        amd64) mtriple=x86_64-unknown-linux-gnu; msum="${MERMAN_SHA256_AMD64}" ;; \
        arm64) mtriple=aarch64-unknown-linux-gnu; msum="${MERMAN_SHA256_ARM64}" ;; \
        *) echo "no merman pin for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/merman.tar.xz "https://github.com/Latias94/merman/releases/download/v${MERMAN_VERSION}/merman-cli-${mtriple}.tar.xz"; \
    echo "${msum}  /tmp/merman.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/merman.tar.xz -C /tmp; \
    install -m 0755 "/tmp/merman-cli-${mtriple}/merman-cli" /usr/local/bin/merman-cli; \
    install -d /usr/share/doc/merman; \
    install -m 0644 "/tmp/merman-cli-${mtriple}/LICENSE-MIT" "/tmp/merman-cli-${mtriple}/LICENSE-APACHE" "/tmp/merman-cli-${mtriple}/THIRD_PARTY_NOTICES.md" /usr/share/doc/merman/; \
    rm -rf /tmp/merman.tar.xz "/tmp/merman-cli-${mtriple}"; \
    merman-cli --version; \
    # Keep only the families a PDF names: Noto Sans and Noto Sans Mono
    # (D13), and Noto Serif for a house style that asks for it (RFC GR P4c).
    # The rest of the Noto set is some hundreds of MB this image does not need.
    find /usr/share/fonts/truetype/noto -type f ! -name 'NotoSans-*' ! -name 'NotoSansMono-*' ! -name 'NotoSerif-*' -delete; \
    # A style's fonts (RFC HB D1), in the faces a document uses: Inter's
    # regular, bold, semibold and their italics (InterDisplay and the other
    # weights go), Carlito's four, and Liberation Sans and Serif (not Mono).
    # About 10 MB in all.
    find /usr/share/fonts/opentype/inter -type f ! -name 'Inter-Regular.otf' ! -name 'Inter-Italic.otf' \
        ! -name 'Inter-Bold.otf' ! -name 'Inter-BoldItalic.otf' ! -name 'Inter-SemiBold.otf' ! -name 'Inter-SemiBoldItalic.otf' -delete; \
    find /usr/share/fonts/truetype/liberation -type f -name 'LiberationMono-*' -delete; \
    test -f /usr/share/fonts/opentype/inter/Inter-Regular.otf; \
    test -f /usr/share/fonts/truetype/crosextra/Carlito-Regular.ttf; \
    test -f /usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf; \
    command -v djvutxt djvused ddjvu; \
    # curl stays: djvulibre-bin depends on it (Debian ships trixie's
    # 3.5.28-2.2, with the fix for CVE-2025-53367), and purging it would
    # take DjVuLibre with it. Nothing here runs it.
    apt-get purge -y --auto-remove xz-utils; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 65532 nonroot; \
    useradd --uid 65532 --gid 65532 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin nonroot; \
    install -d -o 65532 -g 65532 -m 0700 /scratch

COPY loomcycle /usr/local/bin/loomcycle
COPY LICENSE NOTICE /usr/share/doc/loomcycle/

ENV LOOMCYCLE_WORKER_SCRATCH=/scratch \
    LOOMCYCLE_WORKER_MEDIA_COMMAND="ffmpeg -nostdin -i {in} -ac 1 -ar 16000 -f wav {out}" \
    LOOMCYCLE_WORKER_RASTERIZE_COMMAND="pdftoppm -r 150 -png {in} {out_prefix}" \
    LOOMCYCLE_WORKER_ENCODE_COMMAND="ffmpeg -nostdin -i {in} -c:a libopus -b:a 32k {out}" \
    LOOMCYCLE_WORKER_WRITE_COMMAND="typst compile --root {dir} {in} {out}"

USER 65532:65532
WORKDIR /scratch
ENTRYPOINT ["/usr/local/bin/loomcycle", "worker"]

# A workspace worker on the container engine: the worker plus the docker
# client. Run it with the daemon's socket, its group (group_add), and its
# workspace root mounted at the same path inside and out (docs/WORKERS.md).
FROM worker AS ws-worker
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
ENV DOCKER_CONFIG=/scratch/.docker \
    TMPDIR=/scratch

# The default target stays the conversion worker (release.yml's patch build
# and every existing deployment build it without --target).
FROM worker
