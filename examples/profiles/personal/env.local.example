# loomcycle personal profile: secrets. Copy to env.local, chmod 600, and keep
# it out of version control. Every line is optional.

# One provider key is enough; with none, only your local Ollama is used.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# A bearer for the API and the Web UI. Unset, the runtime accepts any caller,
# which it allows only on a loopback address.
#   openssl rand -hex 32
# LOOMCYCLE_AUTH_TOKEN=

# Web search for the chat agents.
# BRAVE_API_KEY=
