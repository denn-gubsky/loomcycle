# loomcycle personal profile: settings that are not secrets.
# Copy to env.insecure. Secrets go in env.local, never here.

# What to run is said in loomcycle.yaml (`presets: [personal]`). Setting this
# variable selects a stack here instead; it wins over the yaml.
# LOOMCYCLE_PRESETS=personal

# Your local Ollama. Delete the line to use cloud models only.
OLLAMA_BASE_URL=http://localhost:11434
# The context window of every local model. Ollama's own default is 4096.
# LOOMCYCLE_OLLAMA_LOCAL_NUM_CTX=32768

# Where it listens (the default). Any other address needs LOOMCYCLE_AUTH_TOKEN.
# LOOMCYCLE_LISTEN_ADDR=127.0.0.1:8787

# ─── Opt-in. Each line loosens something; leave it out unless you want that ───
# The chat agents list Bash, Bashbox, Write, Edit, HTTP, WebFetch and WebSearch
# in their tools. The lines below decide which of those do anything.
#
# opt-in; the HTTP and WebFetch tools may reach these hosts (none without it).
# Private addresses stay blocked. `*` allows any public host.
# LOOMCYCLE_HTTP_HOST_ALLOWLIST=example.com
#
# opt-in; the chat agents get a real shell that runs as you. It starts in the
# volume you gave them and is not confined to it: it can read and change
# anything your user can, and use the network. Bashbox needs no switch and is
# confined to the volume, with no network.
# LOOMCYCLE_BASH_ENABLED=1
#
# opt-in; lets an agent that an MCP client (your editor, say) registers ask
# for Bash, Bashbox, Write and Edit. Only for a client you started yourself.
# LOOMCYCLE_MCP_ALLOW_PRIVILEGED_TOOLS=1
