# loomcycle server profile: settings that are not secrets.
# Copy to env.insecure; the compose file passes it to the container.
# Secrets go in env.local, never here.

# What to run is said in config/loomcycle.yaml (`presets: [server]`). Setting
# this variable selects a stack here instead; it wins over the yaml.
# LOOMCYCLE_PRESETS=server

# Listen on every interface inside the container; the compose file decides
# which host address publishes it. A non-loopback address with no way to
# authenticate is refused at boot.
LOOMCYCLE_LISTEN_ADDR=0.0.0.0:8787
# The address people and links reach it at. Sign-in gates build their redirect
# and invite links from it.
LOOMCYCLE_PUBLIC_URL=https://loomcycle.example.com

# Paths inside the container; the compose file mounts them.
LOOMCYCLE_CONFIG_DIR=/config
LOOMCYCLE_DATA_DIR=/data
# A copy of the audit trail as a file. The sign-in gate in the yaml already
# keeps the audit trail in the store, which is what subject erasure needs.
LOOMCYCLE_AUDIT_LOG_PATH=/data/audit.log

# Traces, to your OpenTelemetry collector. Off until you set the endpoint to
# your own collector's address, with its scheme (use https:// off your own
# network: spans name agents, tools and tenants). Credentials for it go in
# env.local (OTEL_EXPORTER_OTLP_HEADERS).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.example.com:4318
# OTEL_SERVICE_NAME=loomcycle

# Local models beside the cloud ones, tried first when reachable.
# OLLAMA_BASE_URL=http://ollama.example.com:11434

# Semantic recall on Postgres; needs memory.embedder in the yaml.
# LOOMCYCLE_PGVECTOR_ENABLED=1

# ─── Access control. Off by default; yours to turn on, never a preset's ───
# Your own rule lists. shadow keeps the scope gates deciding and logs where
# your rules would decide differently; enforce lets the rules decide. Run
# shadow until the log is quiet.
# LOOMCYCLE_ACL=shadow
# A tenant's runs use only provider keys the tenant supplied, never yours.
# LOOMCYCLE_OPERATOR_KEY_RESTRICTION=1

# ─── Opt-in. Each line loosens something for EVERY tenant; none is per tenant ───
# The bundled chat agents list Bash, Bashbox, Write, Edit, HTTP, WebFetch,
# WebSearch and Agent in their tools, and any user of any tenant may run them.
# The lines below decide which of those tools do anything.
#
# opt-in; one list for the whole server: the HTTP and WebFetch tools of every
# tenant's agents may reach these hosts (none without it). Private addresses
# stay blocked. Name hosts; `*` lets any user's agent fetch any public URL.
# LOOMCYCLE_HTTP_HOST_ALLOWLIST=example.com
#
# opt-in; LEAVE OFF on a server with more than one tenant. It gives every
# user's chat agent an unsandboxed shell in this container as soon as the
# agent has a writable volume. The shell starts in that volume and is not
# confined to it: it reaches other tenants' directories by absolute path, and
# the network. Bashbox needs no switch, is confined to the agent's volume and
# has no network: it is the shell for a shared server.
# LOOMCYCLE_BASH_ENABLED=1
#
# opt-in; lets an agent that a client registers over MCP ask for Bash,
# Bashbox, Write and Edit. On a server, MCP clients are remote and hold tenant
# tokens: leave it off unless every one of them is yours.
# LOOMCYCLE_MCP_ALLOW_PRIVILEGED_TOOLS=1
