# loomcycle server profile: secrets. Copy to env.local, chmod 600, and keep it
# out of version control. The compose file reads it with --env-file and
# refuses to start while a required one is empty.

# ─── Required ──────────────────────────────────────────────────────────
# The operator's bearer for the API and the Web UI.
#   openssl rand -hex 32
LOOMCYCLE_AUTH_TOKEN=
# Seals stored credentials, password hashes and sessions. Losing it loses them.
#   openssl rand -base64 32
LOOMCYCLE_SECRET_KEY=
# The bundled Postgres' password. Hex only: it is also written into the two
# URLs below.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# The store, and the second database SQL Memory and Documents live in. Its
# role must be allowed to create roles (the bundled Postgres' is).
#   postgres://loomcycle:<POSTGRES_PASSWORD>@postgres:5432/loomcycle?sslmode=disable
#   postgres://loomcycle:<POSTGRES_PASSWORD>@postgres:5432/loomcycle_sqlmem?sslmode=disable
LOOMCYCLE_PG_DSN=
LOOMCYCLE_SQLMEM_PG_DSN=

# ─── Provider keys: at least one, unless every model is local ──────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ─── Only if the yaml names them ───────────────────────────────────────
# An OIDC gate's client secret (auth.gates.<name>.client_secret_env).
# LOOMCYCLE_GATE_SSO_SECRET=
# A declared principal's bearer (principals.<name>.token_env).
# LOOMCYCLE_TOKEN_REPORTING=
# Headers your collector needs, as key=value pairs.
# OTEL_EXPORTER_OTLP_HEADERS=
