# loomcycle server profile: secrets. Copy to env.local, chmod 600, and keep it
# out of version control. The compose file reads it with --env-file and
# refuses to start while a required one is empty.

# ─── Required ──────────────────────────────────────────────────────────
# The operator's bearer for the API and the Web UI.
#   openssl rand -hex 32
LOOMCYCLE_AUTH_TOKEN=
# Seals stored credentials, password hashes and sessions. Losing it loses them.
#   openssl rand -base64 32
LOOMCYCLE_SECRET_KEY=
# The bundled Postgres' superuser password. Used once, to initialise the
# database; the runtime never connects as the superuser.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# The password of the role the runtime connects as (`loomcycle`: not a
# superuser, may create roles, owns the two databases). Hex only: it is also
# written into the two URLs below. Read when the database is first
# initialised; changing it later means ALTER ROLE.
#   openssl rand -hex 24
LOOMCYCLE_DB_PASSWORD=
# The store, and the second database SQL Memory and Documents live in.
#   postgres://loomcycle:<LOOMCYCLE_DB_PASSWORD>@postgres:5432/loomcycle?sslmode=disable
#   postgres://loomcycle:<LOOMCYCLE_DB_PASSWORD>@postgres:5432/loomcycle_sqlmem?sslmode=disable
LOOMCYCLE_PG_DSN=
LOOMCYCLE_SQLMEM_PG_DSN=

# ─── Not a secret, but compose reads this file ─────────────────────────
# The release to run: the image tag, without a `v`. It must be a release that
# has the `server` preset.
LOOMCYCLE_VERSION=

# ─── Provider keys: at least one, unless every model is local ──────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ─── Only if the yaml names them ───────────────────────────────────────
# An OIDC gate's client secret (auth.gates.<name>.client_secret_env).
# LOOMCYCLE_GATE_SSO_SECRET=
# A declared principal's bearer (principals.<name>.token_env).
# LOOMCYCLE_TOKEN_REPORTING=
# Headers your collector needs, as key=value pairs.
# OTEL_EXPORTER_OTLP_HEADERS=
