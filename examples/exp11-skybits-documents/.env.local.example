# exp11 secrets — copy to .env.local (run.sh does it on first run).
# Needs: a model provider + a Skybits connector API key.

# Bearer for the loomcycle REST API (/v1/*). Empty = dev open mode (no auth).
# For a non-trivial setup: openssl rand -hex 32
LOOMCYCLE_AUTH_TOKEN=

# Model fallback (deepseek-v4-pro). Or use Anthropic OAuth (loomcycle anthropic login).
DEEPSEEK_API_KEY=

# --- Skybits (remote MCP target) ---
# SECRET: Skybits connector API key (plain Bearer). Mint one via the OAuth
# device flow using Skybits' public helper from https://skybits.ai/skill:
#   python scripts/skybits.py login <name>
# or POST https://skybits.ai/v1/mcp/connectors with scopes
# ["mcp.connect","agent.tools.read","agent.tools.write"]. See README.md.
LOOMCYCLE_SKYBITS_TOKEN=
