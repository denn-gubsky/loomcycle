{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,

    "types": ["vite/client", "node"],

    // @loomcycle/code-editor is a sibling package, checked from its source
    // (as web does) so a change to it and its use here land in one commit.
    "paths": {
      "@loomcycle/code-editor": ["../code-editor/src/index.ts"],
      "@loomcycle/code-editor/styles.css": ["../code-editor/src/styles.css"]
    }
  },
  "include": ["src", "vite.config.lib.ts", "vitest.config.ts"]
}
