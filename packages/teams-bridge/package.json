{
  "name": "@loomcycle/teams-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Microsoft Teams bot for loomcycle interactive agents (RFC EN): each Teams user chats with a loomcycle agent as their own loomcycle user, with streamed replies, steering, question and review cards, and restart recovery.",
  "license": "Apache-2.0",
  "author": "Dennis Gubsky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denn-gubsky/loomcycle.git",
    "directory": "packages/teams-bridge"
  },
  "keywords": ["loomcycle", "teams", "microsoft-teams", "bot", "agent", "ai"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "loomcycle-teams-bridge": "./dist/cli.js"
  },
  "files": ["dist", "appPackage", "README.md"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@loomcycle/client": "^1.112.0",
    "@microsoft/teams.api": "~2.1.0",
    "@microsoft/teams.apps": "~2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
