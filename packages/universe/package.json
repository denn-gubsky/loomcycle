{
  "name": "@loomcycle/universe",
  "version": "0.3.1",
  "type": "module",
  "description": "Embeddable 3D star-map navigator for loomcycle documents (RFC FQ) — documents as constellations of chunk stars, grouped by Path directories into formations, with selection, typed links, search and level of detail. Mounts standalone or as the @loomcycle/explorer navigator.",
  "license": "Apache-2.0",
  "author": "Dennis Gubsky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denn-gubsky/loomcycle.git",
    "directory": "packages/universe"
  },
  "keywords": [
    "loomcycle",
    "documents",
    "knowledge-base",
    "3d",
    "three",
    "visualization",
    "react",
    "component"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json && cp src/styles.css dist/styles.css",
    "prepack": "npm run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "dev": "vite --config dev/vite.config.ts"
  },
  "dependencies": {
    "camera-controls": "3.1.2"
  },
  "peerDependencies": {
    "@loomcycle/client": "^1.127.0",
    "@loomcycle/explorer": ">=0.11.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@loomcycle/client": "^1.127.0",
    "@loomcycle/explorer": "^0.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
