{
  "name": "@loomcycle/bridge-teams",
  "version": "0.2.0",
  "type": "module",
  "description": "Microsoft Teams bridge for loomcycle interactive agents (RFC EN, on @loomcycle/bridge-core per RFC EQ): each Teams user chats with a loomcycle agent as their own loomcycle user, with streamed replies, steering, question and review cards, and restart recovery.",
  "license": "Apache-2.0",
  "author": "Dennis Gubsky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denn-gubsky/loomcycle.git",
    "directory": "packages/bridge-teams"
  },
  "keywords": [
    "loomcycle",
    "bridge",
    "teams",
    "microsoft-teams",
    "bot",
    "agent",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "loomcycle-bridge-teams": "./dist/cli.js"
  },
  "files": [
    "dist",
    "appPackage",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@loomcycle/bridge-core": "^0.2.1",
    "@microsoft/teams.api": "~2.1.1",
    "@microsoft/teams.apps": "~2.1.1"
  },
  "devDependencies": {
    "@loomcycle/client": "^1.115.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
