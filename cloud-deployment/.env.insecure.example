# .env.insecure — NON-SECRET operational settings (safe to read/commit/review).
# Copy to `.env.insecure` and adjust. Loaded (a) into loomcycle/migrate via
# `env_file:` and (b) for `${VAR}` compose interpolation via `--env-file`.
# NEVER put a secret here — those go in .env.secure.

# ── core ──────────────────────────────────────────────────────────────────────
LOOMCYCLE_LISTEN_ADDR=0.0.0.0:8787
LOOMCYCLE_CONFIG_DIR=/config
LOOMCYCLE_DATA_DIR=/data
LOOMCYCLE_PRESETS=base,document-agent,chat,agent-teams,team-examples,sandbox,dev-exec,doc-colorizer,memory

# Public identity behind Cloudflare (the tunnel hostname, NOT the internal addr).
# LOOMCYCLE_PUBLIC_CONFIG=1 lets the landing page's /api/config read GET /v1/config.
LOOMCYCLE_PUBLIC_URL=https://app.loomcycle.cloud
LOOMCYCLE_PUBLIC_CONFIG=1

# ── storage (external secrets — the DSNs — live in .env.secure) ────────────────
LOOMCYCLE_STORAGE_BACKEND=postgres
LOOMCYCLE_PG_AUTOMIGRATE=0          # the loomcycle-migrate one-shot handles this
LOOMCYCLE_PGVECTOR_ENABLED=1        # requires pgvector on the PG host (pg18 image has it)
LOOMCYCLE_SQLMEM_ENABLED=1         # Documents / SQL Memory (needs the sqlmem DSN + CREATEROLE)
LOOMCYCLE_PG_MAX_OPEN_CONNS=48
LOOMCYCLE_PG_MIN_IDLE_CONNS=8

# ── ops toggles ────────────────────────────────────────────────────────────────
LOOMCYCLE_SCHEDULER_ENABLED=1
LOOMCYCLE_WEBHOOKS_ENABLED=1
LOOMCYCLE_CODE_AGENTS_ENABLED=1    # REQUIRED by the doc-colorizer + memory bundles (code-js)
LOOMCYCLE_METRICS_ENABLED=1
LOOMCYCLE_METRICS_COLLECT_SYSTEM=1
LOOMCYCLE_METRICS_RETENTION_DAYS=7
LOOMCYCLE_AUDIT_LOG_PATH=/data/audit.log

# ── access control ─────────────────────────────────────────────────────────────
# compat | shadow | enforce. The compose file defaults it to shadow; a value here
# overrides that. shadow: today's scope gates decide and every disagreement with
# the access rules is logged (acl_shadow_diverged). enforce: the rules decide
# (403 acl_denied; 503 acl_unavailable when they cannot be read). Read at startup.
# LOOMCYCLE_ACL=shadow
# LOOMCYCLE_ACL_CACHE_TTL_SECONDS=5   # how long compiled rules are trusted (0 = every request)

# ── code execution (Bashbox in-process + host fallback) ─────────────────────────
# NOTE: the fallback commands only exist in the runtime container if you use the
# `denngubsky/loomcycle-toolbox` image; the plain image is minimal. The `sandbox`
# preset provides a full-toolchain sandbox regardless (see INSTALL.md).
LOOMCYCLE_BASH_ENABLED=1
LOOMCYCLE_BASHBOX_ENABLED=1
LOOMCYCLE_BASHBOX_FALLBACK_ALLOWED_ENV=HOME
LOOMCYCLE_BASHBOX_FALLBACK_COMMANDS=git,gh,curl,rsync,python3,pip3,go,gofmt,cargo,rustc,node,npm,npx,gcc,g++,cc,c++,clang,clang++,make,cmake,pkg-config

# ── outbound HTTP policy ────────────────────────────────────────────────────────
# `*` allows WebFetch/HTTP to any host — convenient but permissive on a PUBLIC box.
# Tighten to a comma-separated allowlist for production.
LOOMCYCLE_HTTP_HOST_ALLOWLIST=*
# `*` covers PUBLIC hosts only. Private addresses stay blocked for WebFetch/HTTP,
# and since v1.101.0 that includes the tailnet range 100.64.0.0/10. List a private
# host or CIDR an agent must reach (comma-separated):
# LOOMCYCLE_HTTP_PRIVATE_HOST_ALLOWLIST=100.64.0.0/10

# ── local inference (Ollama over Tailscale) ─────────────────────────────────────
# Use the peer's RAW tailnet IP — MagicDNS is not available in the shared netns.
# Find it with: docker compose exec tailscale tailscale status
OLLAMA_BASE_URL=http://100.73.18.51:11434
LOOMCYCLE_OLLAMA_DEBUG_THINK=0
# The context size and GPU offload are set in config/loomcycle.yaml
# (providers.ollama-local.options). Those win over LOOMCYCLE_OLLAMA_LOCAL_NUM_CTX /
# _NUM_GPU, so setting them here as well does nothing.

# ── retention sweeper (RFC BM; opt-in) ──────────────────────────────────────────
LOOMCYCLE_RETENTION_ENABLED=1
LOOMCYCLE_RETENTION_INTERVAL_MS=86400000
LOOMCYCLE_RETENTION_EXPORT_DIR=/data/retention-exports
LOOMCYCLE_RETENTION_CHATS_MODE=export+prune
LOOMCYCLE_RETENTION_CHATS_MAX_AGE_MS=7776000000
LOOMCYCLE_RETENTION_CHATS_INTERNAL_MAX_AGE_MS=259200000
# Sweeps subject documents left with no facts and nothing pointing at them. OFF on
# purpose: an empty dossier records that the entity was once known, and it usually
# becomes empty as a side effect of ANOTHER user's erasure. Enable only if you want
# a clean entity directory more than that record.
# LOOMCYCLE_RETENTION_EMPTY_DOSSIER_MODE=export+prune
# LOOMCYCLE_RETENTION_EMPTY_DOSSIER_MAX_AGE_MS=2592000000

# ── trace evidence search (RFC CI; opt-in) ──────────────────────────────────────
# Indexes each USER turn so chats are searchable by what was SAID, not only by their
# auto-generated title. OFF by default: it copies personal data into a second place.
# Assistant turns are never indexed. The window is the row's TTL, so the transcript
# stays complete behind it and an expired turn is unsearchable before any sweep runs.
# LOOMCYCLE_MEMORY_TRACE_INDEX=1
# LOOMCYCLE_MEMORY_TRACE_MAX_AGE_MS=2592000000
# Also index the ASSISTANT's turns. Off even when the index above is on: assistant
# text is the bulk of the volume and the most redundant with the fact layer, since a
# fact distilled from a reply is already searchable.
# LOOMCYCLE_MEMORY_TRACE_ASSISTANT=1
# Older chats are NOT indexed retroactively. To make them searchable, run
#   POST /v1/_memory/backfill_traces?tenant=&user_id=&dry_run=false[&assistant=1]
# which is bounded, re-runnable, and previews by default.

# ── sandbox sidecar (non-secret knobs; the shared token is in .env.secure) ───────
SANDBOX_IMAGE=denngubsky/loomcycle-sandbox-session:1.108.0
SANDBOX_MAX_CPUS=2
SANDBOX_MAX_MEM_MB=2048

# ── landing token-mint (Cloudflare Access — non-secret config) ───────────────────
# The landing mints substrate:tenant tokens for a Cloudflare-Access-authenticated
# visitor, verifying the Access JWT against these. Team domain = your Zero Trust
# team hostname; AUD = the Access application's Application Audience (AUD) tag.
# (The admin bearer the landing mints WITH is LOOMCYCLE_ADMIN_TOKEN in .env.secure.)
CF_ACCESS_TEAM_DOMAIN=YOUR_TEAM.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_ACCESS_APP_AUD
# Scopes every minted tenant token gets (never widen beyond substrate:tenant here).
MINT_SCOPES=substrate:tenant,runs:create
# Tenant id = this prefix + a stable hash of the verified email.
MINT_TENANT_PREFIX=t_
# CSRF origin check for POST /api/mint (the public landing origin).
LANDING_ORIGIN=https://loomcycle.cloud
# Web UI URL-free sign-in: the first-party origin(s) the runtime's /ui may accept
# a bearer handoff FROM over postMessage (the landing that mints tenant tokens),
# comma-separated. Empty ⇒ the postMessage login receiver stays disabled. Set to
# your landing origin so "Sign in" hands the token to /ui WITHOUT a ?token= URL.
LOOMCYCLE_UI_LOGIN_ORIGINS=https://loomcycle.cloud

# ── landing accounts (password gate; AUTH-INTEGRATION.md phases 2–3) ────────────
# Active only once LOOMCYCLE_AUTH_MANAGE_TOKEN (an auth:manage operator token) is
# in .env.secure; without it these do nothing and the site keeps the token vault.
# The password gate's name in config/loomcycle.yaml (auth.gates.<name>).
LANDING_AUTH_GATE=cloud
# Where invite/reset links point and "Open app" goes: the runtime's
# LOOMCYCLE_PUBLIC_URL. The landing refuses a link that does not start with it.
LANDING_APP_URL=https://app.loomcycle.cloud
# Where a new owner lands after setting their password. Must appear VERBATIM in
# the gate's allowed_return_to (an exact match, query string included).
LANDING_SIGNUP_RETURN_TO=https://loomcycle.cloud/?welcome=1

# ── Telegram bridge (optional; INSTALL.md → "Telegram bridge") ───────────────────
# Compose profiles to start. The telegram-bridge service runs only when this
# lists `telegram`; leave it unset until the bridge's three secrets are in
# .env.secure (TELEGRAM_BOT_TOKEN, TELEGRAM_BRIDGE_WEBHOOK_SECRET,
# TELEGRAM_BRIDGE_LOOMCYCLE_TOKEN), or it refuses to start.
# COMPOSE_PROFILES=telegram
# BRIDGE_TELEGRAM_VERSION=0.1.0
# The agent every Telegram conversation runs.
TELEGRAM_BRIDGE_AGENT=chat/medium
# Who may use the bot: numeric Telegram user ids (private chats) and group ids
# (negative; -100… for a supergroup), comma-separated. With neither set and no
# TELEGRAM_BRIDGE_ALLOW_ANYONE=1, the bridge refuses to start.
TELEGRAM_BRIDGE_ALLOWED_USERS=
TELEGRAM_BRIDGE_ALLOWED_CHATS=
# Groups whose members may instruct the agent; other groups' text reaches it as
# untrusted data.
TELEGRAM_BRIDGE_TRUSTED_CHATS=
# The public base URL the tunnel routes to the bridge; the webhook is
# <url>/telegram/webhook, set with Telegram at every start.
TELEGRAM_BRIDGE_PUBLIC_URL=https://telegram.loomcycle.cloud
