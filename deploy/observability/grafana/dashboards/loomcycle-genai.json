        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_token_type) (rate(gen_ai_client_token_usage_bucket[5m])))",
          "legendFormat": "{{gen_ai_token_type}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Model calls (loomcycle names, /metrics)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
